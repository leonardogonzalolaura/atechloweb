# Apache .htaccess - Configuración Básica
# ATECHLO Website

# ============================================
# COMPRESIÓN GZIP
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# CACHÉ DE PRODUCCIÓN
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: siempre fresco
  ExpiresByType text/html "access plus 0 seconds"
  # CSS y JS: 30 días
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  # Imágenes y fuentes: 1 año
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Estáticos con versión (?v=): caché larga
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # HTML: sin caché (siempre actual)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================
# SEGURIDAD BÁSICA
# ============================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevenir acceso a archivos sensibles
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "(package\.json|package-lock\.json|\.gitignore|\.htaccess)$">
  Order allow,deny
  Deny from all
</FilesMatch>
